# Copy to .env (gitignored) and edit. Docker Compose loads it automatically.
# Use forward slashes for Windows paths.

# Folder containing the PDFs to convert (mounted read-only)
PDF_IN=C:/path/to/pdfs

# Folder the .cbz files are written to (can be the same as PDF_IN)
CBZ_OUT=C:/path/to/cbz

# Scratch folder for GraphicsMagick temp files (mounted as /tmp)
HOST_TMP=C:/HostTemp
